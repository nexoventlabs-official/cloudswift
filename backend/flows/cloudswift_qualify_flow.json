{
  "version": "6.3",
  "data_api_version": "3.0",
  "routing_model": {
    "SIZE": ["SITUATION"],
    "SITUATION": ["TIMELINE"],
    "TIMELINE": ["ROLE"],
    "ROLE": []
  },
  "screens": [
    {
      "id": "SIZE",
      "title": "About your company",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "First — roughly how many employees does your company have?" },
          {
            "type": "RadioButtonsGroup",
            "name": "company_size",
            "label": "Company size",
            "required": true,
            "data-source": [
              { "id": "under_100", "title": "Under 100" },
              { "id": "100_500", "title": "100–499" },
              { "id": "500_plus", "title": "500+" }
            ]
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "company_size": "${form.company_size}" }
            }
          }
        ]
      }
    },
    {
      "id": "SITUATION",
      "title": "Your situation",
      "data": {
        "company_size": { "type": "string", "__example__": "under_100" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Where are you right now with cloud?" },
          {
            "type": "RadioButtonsGroup",
            "name": "situation",
            "label": "Current situation",
            "required": true,
            "data-source": [
              { "id": "exploring", "title": "Researching" },
              { "id": "first_eval", "title": "First evaluation" },
              { "id": "switching", "title": "Switching / problem" }
            ]
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "company_size": "${data.company_size}",
                "situation": "${form.situation}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "TIMELINE",
      "title": "Your timeline",
      "data": {
        "company_size": { "type": "string", "__example__": "under_100" },
        "situation": { "type": "string", "__example__": "switching" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "What's your timeline for a decision?" },
          {
            "type": "RadioButtonsGroup",
            "name": "timeline",
            "label": "Decision timeline",
            "required": true,
            "data-source": [
              { "id": "this_quarter", "title": "This quarter" },
              { "id": "next_quarter", "title": "Next quarter" },
              { "id": "six_months", "title": "6+ months" }
            ]
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "company_size": "${data.company_size}",
                "situation": "${data.situation}",
                "timeline": "${form.timeline}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ROLE",
      "title": "Your role",
      "data": {
        "company_size": { "type": "string", "__example__": "under_100" },
        "situation": { "type": "string", "__example__": "switching" },
        "timeline": { "type": "string", "__example__": "this_quarter" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Last one — what's your role in this decision?" },
          {
            "type": "RadioButtonsGroup",
            "name": "role",
            "label": "Your role",
            "required": true,
            "data-source": [
              { "id": "decision_maker", "title": "Decision-maker" },
              { "id": "evaluating_team", "title": "Evaluating for team" }
            ]
          },
          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "company_size": "${data.company_size}",
                "situation": "${data.situation}",
                "timeline": "${data.timeline}",
                "role": "${form.role}"
              }
            }
          }
        ]
      }
    }
  ]
}
